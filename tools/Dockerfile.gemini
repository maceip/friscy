# Dockerfile.gemini - Build riscv64 Alpine rootfs with Node.js + Gemini CLI
#
# Usage:
#   docker buildx build --platform linux/riscv64 -f tools/Dockerfile.gemini -t friscy-gemini . --load

FROM --platform=linux/riscv64 alpine:edge

# Install Node.js, npm, build tools (tree-sitter needs C++ compiler)
RUN apk add --no-cache nodejs npm curl bash python3 make g++

# Add the proven command-loop runner used by browser checkpoint ladders.
COPY runtime/claude-repl.js /usr/local/bin/claude-repl.js
RUN chmod +x /usr/local/bin/claude-repl.js
COPY runtime/gemini-repl.js /usr/local/bin/gemini-repl.js
RUN chmod +x /usr/local/bin/gemini-repl.js

# Install Gemini CLI globally via npm
RUN npm install -g @google/gemini-cli

# Strip non-riscv64 prebuilds (saves ~80MB)
RUN find /usr/local/lib/node_modules/@google/gemini-cli -path "*/prebuilds/darwin-*" -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib/node_modules/@google/gemini-cli -path "*/prebuilds/win32-*" -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib/node_modules/@google/gemini-cli -path "*/prebuilds/linux-x64*" -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib/node_modules/@google/gemini-cli -path "*/prebuilds/linux-arm64*" -exec rm -rf {} + 2>/dev/null; \
    # Remove build artifacts (we have prebuilds)
    find /usr/local/lib/node_modules/@google/gemini-cli -name "build" -path "*/node-gyp*" -exec rm -rf {} + 2>/dev/null; \
    find /usr/local/lib/node_modules/@google/gemini-cli -name "obj.target" -exec rm -rf {} + 2>/dev/null; \
    # Remove tree-sitter debug wasm
    rm -rf /usr/local/lib/node_modules/@google/gemini-cli/node_modules/web-tree-sitter/debug 2>/dev/null; \
    # Remove @types (not needed at runtime)
    rm -rf /usr/local/lib/node_modules/@google/gemini-cli/node_modules/@types 2>/dev/null; \
    true

# Clean up build tools to reduce image size
RUN apk del python3 make g++ && rm -rf /root/.npm /tmp/*

# Default shell
CMD ["/bin/sh"]
