# Disable all console-tools (require Linux headers)
# Run: make KCONFIG_ALLCONFIG=../config.disable-console allnoconfig
CONFIG_CHVT=n
CONFIG_CLEAR=n
CONFIG_DEALLOCVT=n
CONFIG_DUMPKMAP=n
CONFIG_FGCONSOLE=n
CONFIG_KBD_MODE=n
CONFIG_LOADFONT=n
CONFIG_LOADKMAP=n
CONFIG_OPENVT=n
CONFIG_RESET=n
CONFIG_RESIZE=n
CONFIG_SETCONSOLE=n
CONFIG_SETKEYCODES=n
CONFIG_SETLOGCONS=n
CONFIG_SHOWKEY=n

# Core utilities we want
CONFIG_SH=y
CONFIG_ASH=y
CONFIG_ECHO=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_PWD=y
CONFIG_MKDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_CHMOD=y
CONFIG_GREP=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_SLEEP=y
CONFIG_ENV=y
CONFIG_PRINTF=y
CONFIG_PIPE=y

# Static build required
CONFIG_STATIC=y
CONFIG_FEATURE_PREFER_APPLETS=y
