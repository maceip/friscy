{
  "version": 1,
  "image": "test-main-path-jit-activation",
  "rootfs": "./rootfs.tar",
  "entrypoint": [
    "/bin/sh",
    "-lc",
    "i=0; while [ $i -lt 200000 ]; do i=$((i+1)); done; echo done"
  ],
  "workdir": "/",
  "env": [
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME=/root",
    "TERM=xterm-256color",
    "NO_COLOR=1"
  ],
  "aot": []
}