@@ -75,14 +74,49 @@ void Machine<W>::install_syscall_handlers(std::initializer_list<std::pair<size_t
 		install_syscall_handler(scall.first, scall.second);
 }
 
+// Ring buffer for last N syscalls (used for abort diagnostics)
+struct SyscallTrace {
+	size_t sysnum;
+	uint64_t a0, a1, a2;
+	int64_t result;
+	uint64_t pc;
+};
+inline SyscallTrace g_syscall_ring[32] = {};
+inline int g_syscall_ring_idx = 0;
+
 template <int W>
 inline void Machine<W>::system_call(size_t sysnum)
 {
+	auto& entry = g_syscall_ring[g_syscall_ring_idx % 32];
+	entry.sysnum = sysnum;
+	entry.a0 = cpu.reg(REG_ARG0);
+	entry.a1 = cpu.reg(REG_ARG0 + 1);
+	entry.a2 = cpu.reg(REG_ARG0 + 2);
+	entry.pc = cpu.pc();
+
+	// Periodic progress report
+	static size_t total_syscalls = 0;
+	if (++total_syscalls % 1000000 == 0)
+		fprintf(stderr, "[progress] %zuM syscalls, last=sys#%zu\n", total_syscalls / 1000000, sysnum);
+
 	if (LIKELY(sysnum < syscall_handlers.size())) {
-		Machine::syscall_handlers[RISCV_SPECSAFE(sysnum)](*this);
+		auto& handler = Machine::syscall_handlers[RISCV_SPECSAFE(sysnum)];
+		if (!handler) {
+			// Return -ENOSYS for unhandled syscalls instead of crashing
+			static size_t unhandled_count = 0;
+			if (++unhandled_count <= 20)
+				fprintf(stderr, "[UNHANDLED] sysnum=%zu PC=0x%lX\n", sysnum, (long)cpu.pc());
+			cpu.reg(REG_ARG0) = -38; // -ENOSYS
+			entry.result = -38;
+			g_syscall_ring_idx++;
+			return;
+		}
+		handler(*this);
 	} else {
 		on_unhandled_syscall(*this, sysnum);
 	}
+	entry.result = (int64_t)cpu.reg(REG_ARG0);
+	g_syscall_ring_idx++;
 }
 
