{
  "version": 1,
  "image": "matrix-run",
  "rootfs": "./claude-real.tar",
  "entrypoint": [
    "/bin/bash",
    "-i"
  ],
  "workdir": "/",
  "env": [
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME=/root",
    "TERM=xterm-256color",
    "ANTHROPIC_API_KEY=",
    "LD_PRELOAD=/usr/lib/vh_preload.so"
  ],
  "aot": [],
  "examples": {
    "claude-tui": {
      "image": "friscy-claude-tui",
      "rootfs": "./claude-real.tar",
      "entrypoint": [
        "/bin/bash",
        "-i"
      ],
      "env": [
        "ANTHROPIC_API_KEY=PLACEHOLDER"
      ]
    },
    "codex": {
      "image": "friscy-codex",
      "rootfs": "./codex-real.tar",
      "entrypoint": [
        "/bin/bash",
        "-i"
      ],
      "env": [
        "OPENAI_API_KEY=PLACEHOLDER"
      ]
    },
    "gemini-tui": {
      "image": "friscy-gemini-tui",
      "rootfs": "./gemini-real.tar",
      "entrypoint": [
        "/bin/bash",
        "-i"
      ],
      "env": [
        "GEMINI_API_KEY=PLACEHOLDER",
        "GOOGLE_API_KEY=PLACEHOLDER"
      ]
    }
  }
}